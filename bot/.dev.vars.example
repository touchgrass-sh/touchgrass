# The Deploy to Cloudflare button asks for these three. The setup page at https://touchgrass.sh/setup makes the two
# keys for you and checks your bot token before you paste anything here.
# Left blank on purpose: Cloudflare's form pre-fills (and hides) whatever is here, so a placeholder would look like a
# real value.
BOT_TOKEN=
WEBHOOK_SECRET=
HOOK_KEY=
